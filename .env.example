# PatientAgentBench - Environment Configuration
# Copy this file to .env and fill in your values.
#
# NOTE: .env is loaded with override=True, so any variable set here wins over
# the same variable already exported in your shell. Leave a variable commented
# out to keep your ambient value (or to let boto3 resolve it itself).
#
# NOTE: Model configuration (model_id, temperature, max_turns) lives in a
# separate JSON config file. See data/default_config.json.

# =============================================================================
# AWS Credentials (for AWS Bedrock model access)
# =============================================================================
# PatientAgentBench uses the standard AWS credential chain (boto3). Provide
# credentials by any standard means: environment variables, a shared profile
# (~/.aws/credentials via `aws configure`), or an instance/role profile when
# running on AWS.

# Option 1: Direct credentials (e.g. for CI/CD or manual override)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token   # Only for temporary credentials

# Option 2: Use a named AWS profile (from ~/.aws/credentials)
# AWS_PROFILE=your-profile-name

# Optional: assume an IAM role for Bedrock access (leave empty to use base creds)
# AWS_ARN_ROLE=arn:aws:iam::123456789012:role/your-role

# =============================================================================
# AWS Region Configuration
# =============================================================================

# Default region for AWS services (used by all Bedrock models). Leave commented
# out to let boto3 resolve the region itself (shell env, AWS profile, instance
# metadata).
# AWS_REGION=us-west-2

# =============================================================================
# OpenAI API Configuration
# =============================================================================

# OpenAI API key (required only when calling models directly via the OpenAI API,
# i.e. provider="openai-protocol-api" with auth="api_key")
# OPENAI_API_KEY=sk-...

# =============================================================================
# Anthropic API Configuration
# =============================================================================

# Anthropic API key (required only when calling models directly via the Anthropic
# API, i.e. provider="anthropic-protocol-api" with auth="api_key")
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# LiteLLM Proxy Configuration (OpenAI-compatible endpoint)
# Required only for registry models routed through a LiteLLM proxy. Works with
# any LiteLLM-based proxy that exposes /v1/chat/completions.
# =============================================================================

# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-...

# =============================================================================
# AWS Bedrock Mantle Gateway (OpenAI-compatible, SigV4 auth)
# Used by Mantle models (provider="openai-protocol-api", auth="sigv4"). Auth uses
# your ambient AWS credentials (SigV4) — no API key needed. The host is derived
# as bedrock-mantle.{region}.api.aws, where region = MANTLE_REGION if set,
# otherwise AWS_REGION.
#
# Set MANTLE_REGION only when Mantle should use a different region than your
# Bedrock calls. Mantle model availability differs by region.
# =============================================================================

# MANTLE_REGION=us-east-1
